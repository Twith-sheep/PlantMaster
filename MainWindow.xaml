<Window x:Class="PlantMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PlantMaster"
        Width="1220"
        Height="860"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0"
                Background="#F8FBFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4D8DFF" Offset="0"/>
                                <GradientStop Color="#635BDF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="15" Height="15" Fill="White" Opacity="0.95"/>
                            <Ellipse Width="6" Height="6" Fill="#4D8DFF"/>
                            <Path Data="M 6,18 L 12,12 M 24,18 L 18,12 M 18,24 L 18,18"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="PlantMaster"
                                   FontSize="19"
                                   FontWeight="Bold"/>
                        <TextBlock Text="PLC Master System"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="1,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Height="32"
                            IsEnabled="False"
                            ToolTip="系统设置待接入">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="系统设置"/>
                        </StackPanel>
                    </Button>

                    <Border Margin="6,0,10,0"
                            Padding="8,4"
                            CornerRadius="14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Background="White"
                            ToolTip="深色主题待接入">
                        <StackPanel Orientation="Horizontal"
                                    IsEnabled="False">
                            <TextBlock Text="浅色" FontSize="12" VerticalAlignment="Center"/>
                            <Border Width="34" Height="18" Margin="7,0"
                                    CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                                <Ellipse Width="14" Height="14"
                                         Margin="17,2,2,2"
                                         Fill="White"/>
                            </Border>
                            <TextBlock Text="深色" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Width="40" Height="40"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="—"
                            FontSize="16"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton"
                            Width="40" Height="40"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="□"
                            FontSize="16"
                            Click="MaximizeButton_Click"/>
                    <Button Width="40" Height="40"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="×"
                            FontSize="20"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体、日志 -->
        <Grid Grid.Row="1" Margin="10,10,10,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="350"/>
                <RowDefinition Height="6"/>
                <RowDefinition x:Name="LogRow" Height="220" MinHeight="120"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="270" MaxWidth="360"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧网关管理 -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="232"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource PrimarySoftBrush}">
                                    <TextBlock Text="▣" Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="网关管理" Style="{StaticResource SectionTitleStyle}" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding GatewayCount, Mode=OneWay, StringFormat=({0})}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="5,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="＋ 添加网关"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="34"
                                        Padding="10,0"
                                        Margin="0,0,6,0"
                                        IsEnabled="False"
                                        ToolTip="新增网关编辑功能待接入"/>
                                <Button Content="导入"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Height="34"
                                        Padding="10,0"
                                        Command="{Binding ImportGatewayCommand}"
                                        ToolTip="从 XML 配置文件导入网关"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="12,5,12,9">
                            <TextBox x:Name="GatewaySearchBox"
                                     Style="{StaticResource RoundedTextBoxStyle}"
                                     Text="{Binding GatewaySearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="⌕  搜索网关名称、ID 或 IP..."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=GatewaySearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding GatewaysView}"
                                     SelectedItem="{Binding SelectedGateway, Mode=TwoWay}"
                                     Margin="8,0,8,8">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,5"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            CornerRadius="7"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            Background="Transparent"
                                                            Padding="10,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F6F9FD"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C9DEFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="28" Height="34" CornerRadius="5"
                                                    Background="#F2F5F9" VerticalAlignment="Center">
                                                <TextBlock Text="▤" FontSize="17"
                                                           Foreground="#3D5875"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Setting.Name}"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0">
                                                    <Run Text="{Binding Setting.IpAddress}"/><Run Text=":"/><Run Text="{Binding Setting.Port}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2" Padding="7,3" CornerRadius="10" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F3F6"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#A9B4C3"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="离线"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                        <Setter Property="Text" Value="在线"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <Button Grid.Column="3" Content="⋮" IsEnabled="False"
                                                    Width="22" Height="28" Padding="0"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    ToolTip="更多操作待接入"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="暂无网关，请先导入配置"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GatewayCount, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="3"
                                Margin="8,0,8,8"
                                Padding="12"
                                Background="#FAFCFF"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedGateway}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▤" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SelectedGateway.Setting.Name}"
                                                   FontSize="15" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="8,3" CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F3F6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGateway.IsOnline}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="●  离线"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGateway.IsOnline}" Value="True">
                                                            <Setter Property="Text" Value="●  在线"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1" Margin="2,3,2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="名称" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedGateway.Setting.Name}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Text="网关 ID" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGateway.Setting.Id}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Text="IP 地址" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGateway.Setting.IpAddress}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Text="端口" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedGateway.Setting.Port}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="连接"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ConnectGatewayCommand}"/>
                                    <Button Grid.Column="2" Content="断开"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Command="{Binding DisconnectGatewayCommand}"/>
                                    <Button Grid.Column="4" Content="删除"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding DeleteGatewayCommand}"
                                            CommandParameter="{Binding SelectedGateway}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧 PLC 变量监控 -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid Margin="14,0,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="78"/>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource PrimarySoftBrush}">
                                    <TextBlock Text="⌗" Foreground="{StaticResource PrimaryBrush}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="PLC 变量监控" Style="{StaticResource SectionTitleStyle}" Margin="8,0,0,2"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="当前网关" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                                <Border Background="#F1F5FA" CornerRadius="6" Padding="10,5" Margin="9,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedGateway.Setting.Name, TargetNullValue=未选择}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0">
                                            <Run Text="{Binding SelectedGateway.Setting.IpAddress}"/><Run Text=":"/><Run Text="{Binding SelectedGateway.Setting.Port}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Padding="9,4" CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F3F6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGateway.IsOnline}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="●  离线"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGateway.IsOnline}" Value="True">
                                                        <Setter Property="Text" Value="●  在线"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="6,6,0,0" Padding="12,8" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="0,0,0,2">
                                    <TextBlock Text="▦  变量列表" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                </Border>
                                <Button Content="⚙  轮询设置" Style="{StaticResource GhostButtonStyle}" Height="36" IsEnabled="False" ToolTip="PollingService 尚未实现"/>
                                <Button Content="◷  历史数据" Style="{StaticResource GhostButtonStyle}" Height="36" IsEnabled="False" ToolTip="历史数据功能待接入"/>
                                <Button Content="▣  通信测试" Style="{StaticResource GhostButtonStyle}" Height="36" IsEnabled="False" ToolTip="通信测试功能待接入"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="700">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="＋ 添加点位" Style="{StaticResource PrimaryButtonStyle}" Height="32" Margin="0,0,8,0" IsEnabled="False" ToolTip="PLC点位功能待接入"/>
                                    <Button Content="⇩ 导入" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                                    <Button Content="⇧ 导出" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                                    <Button Content="▣ 读取" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="Modbus TCP Driver 尚未实现"/>
                                    <Button Content="✎ 写入" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="Modbus TCP Driver 尚未实现"/>
                                    <Button Content="删除" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="自动轮询" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <Border Width="34" Height="18" Background="#BCC5D1" CornerRadius="9" ToolTip="PollingService 尚未实现">
                                        <Ellipse Width="14" Height="14" Fill="White" Margin="2" HorizontalAlignment="Left"/>
                                    </Border>
                                    <TextBox Width="68" Text="1000" Margin="9,0,4,0" Style="{StaticResource RoundedTextBoxStyle}" IsEnabled="False"/>
                                    <TextBlock Text="ms" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Content="⚙" Width="32" Padding="0" Style="{StaticResource OutlineButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="3">
                            <DataGrid IsReadOnly="True" ToolTip="PLC变量读写功能待接入">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="□" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox HorizontalAlignment="Center"/></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="名称" Width="*"/>
                                    <DataGridTextColumn Header="地址" Width="100"/>
                                    <DataGridTextColumn Header="数据类型" Width="90"/>
                                    <DataGridTextColumn Header="当前值" Width="90"/>
                                    <DataGridTextColumn Header="修改值" Width="90"/>
                                    <DataGridTextColumn Header="读写" Width="80"/>
                                    <DataGridTextColumn Header="描述" Width="1.3*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="⌗" FontSize="24" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="PLC 点位功能待接入"
                                           FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="后续可通过 ViewModel 与 ICommand 接入，无需调整界面布局"
                                           Style="{StaticResource MutedTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="LogSplitter"
                          Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"/>

            <!-- 底部运行日志 -->
            <Border x:Name="LogPanel"
                    Grid.Row="2"
                    Style="{StaticResource CardBorderStyle}">
                <Grid Margin="12,0,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource PrimarySoftBrush}">
                                <TextBlock Text="▤" FontSize="17" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="运行日志" Style="{StaticResource SectionTitleStyle}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" Width="96" Margin="16,0,10,0" IsEnabled="False" ToolTip="日志级别筛选待接入">
                            <ComboBoxItem Content="全部级别" IsSelected="True"/>
                        </ComboBox>

                        <Grid Grid.Column="2">
                            <TextBox Style="{StaticResource RoundedTextBoxStyle}" IsEnabled="False"/>
                            <TextBlock Text="⌕  搜索日志内容..." Style="{StaticResource MutedTextStyle}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="清空" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                            <Button Content="暂停" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                            <Button Content="导出" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" ToolTip="待接入"/>
                            <Button x:Name="CollapseLogButton" Content="⌃" Width="32" Padding="0"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="CollapseLogButton_Click"
                                    ToolTip="折叠运行日志"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Logs}"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间"
                                                Width="165"
                                                Binding="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                            <DataGridTemplateColumn Header="级别" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="来源（待接入）" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="—" Foreground="{StaticResource DisabledTextBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="内容" Width="*" Binding="{Binding Message}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="#F8FBFF"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/>
                    <TextBlock Text="系统运行正常" Foreground="{StaticResource SuccessBrush}" FontSize="12"/>
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                    <TextBlock FontSize="12"><Run Text="网关总数: "/><Run Text="{Binding GatewayCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                    <TextBlock FontSize="12"><Run Text="在线: "/><Run Text="{Binding OnlineGatewayCount, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/></TextBlock>
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                    <TextBlock FontSize="12"><Run Text="离线: "/><Run Text="{Binding OfflineGatewayCount, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="v"/><Run Text="{Binding ApplicationVersion, Mode=OneWay}"/></TextBlock>
                    <Border Width="1" Height="14" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                    <TextBlock Text="{Binding CurrentTime, Mode=OneWay}" Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
